# Copy this file to .env and fill in your values
PORT=3000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/chatapp
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatapp
# Leave empty to use a temporary in-memory MongoDB (data is lost on restart).
MONGO_URI=

# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional: failed login/register attempts allowed per IP every 15 minutes (default 10)
# AUTH_RATE_LIMIT=10
