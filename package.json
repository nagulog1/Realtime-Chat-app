{
  "name": "realtime-chat-app",
  "version": "1.0.0",
  "description": "Real-time chat app with rooms, private messages, history, typing indicators and online status (Node.js, Express, Socket.IO, MongoDB, JWT)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/css/styles.css --watch"
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "mongodb",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "socket.io": "^4.7.5"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.0.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22"
  }
}
